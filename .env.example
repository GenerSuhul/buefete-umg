# Copiar como .env. No versionar el archivo .env real.
POSTGRES_DB=bufete_juridico
POSTGRES_USER=bufete_app
POSTGRES_PASSWORD=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO
POSTGRES_PORT=55432

MINIO_ROOT_USER=bufete_minio
MINIO_ROOT_PASSWORD=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_32_CARACTERES
MINIO_BUCKET=bufete-documentos
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001

# ASP.NET Core usa doble guion bajo para representar secciones de configuración.
ConnectionStrings__BufeteDb=Host=127.0.0.1;Port=55432;Database=bufete_juridico;Username=bufete_app;Password=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO;Maximum Pool Size=30;Minimum Pool Size=2;Connection Idle Lifetime=300;Connection Pruning Interval=10;Keepalive=30;Timeout=15;Command Timeout=30
Database__ApplyMigrationsOnStartup=false
AllowedHosts=localhost;127.0.0.1
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://127.0.0.1:5173
RateLimiting__Authentication__PermitLimit=10
RateLimiting__Authentication__WindowSeconds=60

# Producción: registrar aquí cada proxy inverso autorizado.
# ReverseProxy__KnownProxies__0=10.0.0.10

Jwt__Issuer=BufeteJuridicoUMG
Jwt__Audience=BufeteJuridicoUMG.Web
Jwt__SigningKey=REEMPLAZAR_CON_UN_SECRETO_BASE64_DE_64_BYTES
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

BootstrapAdmin__Username=admin
BootstrapAdmin__Email=admin@bufete.local
BootstrapAdmin__FullName=Administrador General
BootstrapAdmin__Password=REEMPLAZAR_CON_UN_SECRETO_UNICO

Storage__Provider=S3
Storage__RootPath=.data/files
Storage__MaxFileSizeBytes=26214400
Storage__DownloadUrlMinutes=2

# Producción: cambiar Provider=S3. ServiceUrl se deja vacío para AWS S3 y se
# configura para otros proveedores S3 compatibles. Nunca versionar credenciales.
Storage__S3__BucketName=bufete-documentos
Storage__S3__Region=us-east-1
Storage__S3__ServiceUrl=http://127.0.0.1:59000
Storage__S3__ForcePathStyle=true
Storage__S3__AccessKey=bufete_minio
Storage__S3__SecretKey=REEMPLAZAR_CON_EL_MISMO_SECRETO_DE_MINIO
Storage__S3__KeyPrefix=bufete

Scanner__SessionMinutes=30
Scanner__MaximumPages=200
Scanner__CleanupIntervalMinutes=15

Smtp__Enabled=false
Smtp__Host=
Smtp__Port=587
Smtp__UseSsl=true
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=no-reply@bufete.local
Smtp__FromName=Bufete Juridico UMG

# Credenciales opcionales para una cuenta Alumno de desarrollo
DemoStudent__Username=alumno.demo
DemoStudent__Password=CAMBIAR_CONTRASENA_ALUMNO
