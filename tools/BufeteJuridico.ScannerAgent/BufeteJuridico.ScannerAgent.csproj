<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BufeteJuridico.ScannerAgent</AssemblyName>
    <RootNamespace>BufeteJuridico.ScannerAgent</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAPS2.Images.Gdi" />
    <PackageReference Include="NAPS2.Sdk" />
    <PackageReference Include="NAPS2.Sdk.Worker.Win32" />
  </ItemGroup>
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
